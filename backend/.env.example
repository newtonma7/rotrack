# Spring Boot API environment variables.
# Copy to .env, replace every example value, then inject through the shell/IDE/container.

# Use the dedicated Spring application role, not a database owner role.
DATABASE_URL='jdbc:postgresql://db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-db-ca.crt'
DATABASE_USERNAME=rotrack_runtime
DATABASE_PASSWORD=replace-with-development-password
# DATABASE_URL is the only TLS-mode source. For loopback PostgreSQL, activate the local profile
# and use sslmode=disable explicitly. Every other profile requires sslmode=verify-full
# plus an sslrootcert path to the official CA bundle mounted by the runtime.
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_VALIDATION_TIMEOUT_MS=2000
DATABASE_MAXIMUM_POOL_SIZE=5
DATABASE_MINIMUM_IDLE=0
READINESS_CACHE_TTL=5s

SUPABASE_JWKS_URI=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER_URI=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Comma-separated exact origins. Do not use wildcards with credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000
PORT=8080
