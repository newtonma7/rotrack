-- Read-only audit. Run in a separate psql session authenticated as rotrack_runtime.
-- Every returned boolean must be true.
SELECT
  current_user = 'rotrack_runtime' AS dedicated_identity,
  NOT rolsuper AS non_superuser,
  NOT rolinherit AS no_implicit_membership_inheritance,
  rolbypassrls AS bypass_rls,
  NOT rolcreatedb AS cannot_create_database,
  NOT rolcreaterole AS cannot_create_role,
  NOT rolreplication AS cannot_replicate,
  NOT EXISTS (
    SELECT 1 FROM pg_auth_members WHERE member = pg_roles.oid
  ) AS membership_free
FROM pg_roles
WHERE rolname = current_user;

SELECT
  has_table_privilege(current_user, 'public.time_entries', 'SELECT') AS can_select,
  has_table_privilege(current_user, 'public.time_entries', 'INSERT') AS can_insert,
  has_table_privilege(current_user, 'public.time_entries', 'UPDATE') AS can_update,
  has_table_privilege(current_user, 'public.time_entries', 'DELETE') AS can_delete,
  NOT has_table_privilege(current_user, 'public.time_entries', 'TRUNCATE') AS cannot_truncate,
  NOT has_table_privilege(current_user, 'public.time_entries', 'REFERENCES') AS cannot_reference,
  NOT has_table_privilege(current_user, 'public.time_entries', 'TRIGGER') AS cannot_create_trigger,
  NOT has_schema_privilege(current_user, 'public', 'CREATE') AS cannot_create_schema_objects,
  NOT EXISTS (
    SELECT 1
    FROM pg_class relation
    JOIN pg_namespace namespace ON namespace.oid = relation.relnamespace
    WHERE namespace.nspname = 'public'
      AND relation.relname NOT IN ('time_entries', 'user_preferences')
      AND relation.relkind IN ('r', 'p', 'v', 'm', 'f')
      AND (
        has_table_privilege(current_user, relation.oid, 'SELECT') OR
        has_table_privilege(current_user, relation.oid, 'INSERT') OR
        has_table_privilege(current_user, relation.oid, 'UPDATE') OR
        has_table_privilege(current_user, relation.oid, 'DELETE') OR
        has_table_privilege(current_user, relation.oid, 'TRUNCATE') OR
        has_table_privilege(current_user, relation.oid, 'REFERENCES') OR
        has_table_privilege(current_user, relation.oid, 'TRIGGER')
      )
  ) AS no_other_public_relation_privileges,
  NOT EXISTS (
    SELECT 1
    FROM pg_class seq
    JOIN pg_namespace namespace ON namespace.oid = seq.relnamespace
    WHERE namespace.nspname = 'public'
      AND seq.relkind = 'S'
      AND (
        has_sequence_privilege(current_user, seq.oid, 'USAGE') OR
        has_sequence_privilege(current_user, seq.oid, 'SELECT') OR
        has_sequence_privilege(current_user, seq.oid, 'UPDATE')
      )
  ) AS no_public_sequence_privileges;

SELECT
  has_table_privilege(current_user, 'public.user_preferences', 'SELECT') AS preferences_can_select,
  has_table_privilege(current_user, 'public.user_preferences', 'INSERT') AS preferences_can_insert,
  has_table_privilege(current_user, 'public.user_preferences', 'UPDATE') AS preferences_can_update,
  NOT has_table_privilege(current_user, 'public.user_preferences', 'DELETE') AS preferences_cannot_delete,
  NOT has_table_privilege(current_user, 'public.user_preferences', 'TRUNCATE') AS preferences_cannot_truncate,
  NOT has_table_privilege(current_user, 'public.user_preferences', 'REFERENCES') AS preferences_cannot_reference,
  NOT has_table_privilege(current_user, 'public.user_preferences', 'TRIGGER') AS preferences_cannot_create_trigger;

-- The provider database may grant TEMPORARY through PUBLIC; this audit rejects direct
-- runtime-role CREATE/TEMP grants and all database CREATE access. A separate project-level
-- privilege review records any provider-managed PUBLIC baseline.
SELECT
  has_database_privilege(current_user, current_database(), 'CONNECT') AS can_connect,
  NOT has_database_privilege(current_user, current_database(), 'CREATE') AS cannot_create_database_objects,
  NOT EXISTS (
    SELECT 1
    FROM pg_database db
    CROSS JOIN LATERAL aclexplode(
      COALESCE(db.datacl, acldefault('d', db.datdba))
    ) privilege
    JOIN pg_roles runtime_role ON runtime_role.oid = privilege.grantee
    WHERE db.datname = current_database()
      AND runtime_role.rolname = current_user
      AND privilege.privilege_type IN ('CREATE', 'TEMPORARY')
  ) AS no_direct_create_or_temporary_grant,
  NOT EXISTS (
    SELECT 1
    FROM pg_proc routine
    JOIN pg_namespace namespace ON namespace.oid = routine.pronamespace
    WHERE namespace.nspname = 'public'
      AND routine.oid <> 'public.handle_new_user()'::regprocedure
      AND has_function_privilege(current_user, routine.oid, 'EXECUTE')
  ) AS no_unapproved_public_routine_execute,
  EXISTS (
    SELECT 1
    FROM pg_proc routine
    JOIN pg_namespace namespace ON namespace.oid = routine.pronamespace
    WHERE namespace.nspname = 'public'
      AND routine.oid = 'public.handle_new_user()'::regprocedure
      AND routine.prosecdef
      AND routine.prorettype = 'trigger'::regtype
  ) AS approved_signup_trigger_is_security_definer;
