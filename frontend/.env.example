# Public browser configuration; never place database credentials or server secrets here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=replace-with-supabase-anon-or-publishable-key
# Canonical production origin for metadata/canonicals. Never set this to a Vercel preview URL.
NEXT_PUBLIC_SITE_URL=
# Local development default is used only outside production builds.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
