# Public browser configuration; never place database credentials or server secrets here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=replace-with-supabase-anon-or-publishable-key
# Canonical public site origin for metadata, sitemap, and robots.
# Use the actual production origin in deployed builds; localhost is local-only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
