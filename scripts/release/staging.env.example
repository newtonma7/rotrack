# Placeholder-only configuration. Copy outside the repository, replace every
# placeholder from the approved staging inventory. Export it with:
#   set -a; source /external/path/staging.env; set +a
# The release scripts reject .invalid/loopback URLs and placeholder target IDs.
ROTRACK_RELEASE_ENVIRONMENT=staging
ROTRACK_STAGING_TARGET_ID=staging-placeholder
ROTRACK_STAGING_FRONTEND_URL=https://frontend.staging.example.invalid
ROTRACK_STAGING_API_URL=https://api.staging.example.invalid/api/v1
ROTRACK_STAGING_SUPABASE_PROJECT_REF=replace-with-staging-project-ref
ROTRACK_DEVELOPMENT_SUPABASE_PROJECT_REF=replace-with-development-project-ref
ROTRACK_PRODUCTION_SUPABASE_PROJECT_REF=replace-with-production-project-ref
ROTRACK_PRODUCTION_FRONTEND_URL=https://frontend.production.example.invalid
ROTRACK_PRODUCTION_API_URL=https://api.production.example.invalid/api/v1
# Restricted external inventory containing the exact staging/development/production
# identities above. The file is never sourced and must be operator-owned mode 0600.
ROTRACK_STAGING_INVENTORY_FILE=/absolute/external/path/approved-environment.inventory

# Reusable auth material must be regular files outside the repository. The
# scripts and Playwright harness never print or inspect their contents.
ROTRACK_E2E_USER_A_STORAGE_STATE=/absolute/external/path/staging-user-a.json
ROTRACK_E2E_USER_B_STORAGE_STATE=/absolute/external/path/staging-user-b.json

# Optional public-probe timeout (1..120 seconds).
ROTRACK_SMOKE_TIMEOUT_SECONDS=15

# Rollback rehearsal only. Release IDs represent an approved mapping to both
# immutable frontend and backend artifacts in the external release inventory.
ROTRACK_ROLLBACK_REHEARSAL_APPROVED=NOT_APPROVED
ROTRACK_CANDIDATE_RELEASE_ID=replace-with-candidate-release-id
ROTRACK_ROLLBACK_RELEASE_ID=replace-with-prior-release-id
ROTRACK_INSPECT_RELEASE_HOOK=/absolute/external/path/inspect-staging-release
ROTRACK_DEPLOY_RELEASE_HOOK=/absolute/external/path/deploy-staging-release
ROTRACK_DEPLOY_TIMEOUT_SECONDS=600
